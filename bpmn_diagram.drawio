<mxGraphModel>
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Pool container -->
    <mxCell id="pool" value="ListenAI × 四葉草書局 合作流程" style="shape=table;html=1;whiteSpace=wrap;startSize=20;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="1560" height="700" as="geometry" />
    </mxCell>

    <!-- Swimlane 1: 使用者 -->
    <mxCell id="lane1" value="使用者" style="swimlane;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="40" width="1560" height="120" as="geometry" />
    </mxCell>
    <!-- Swimlane 2: 四葉草書評 -->
    <mxCell id="lane2" value="四葉草書評" style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="160" width="1560" height="120" as="geometry" />
    </mxCell>
    <!-- Swimlane 3: 資料分析師 -->
    <mxCell id="lane3" value="四葉草書店&#xa;資料分析師" style="swimlane;startSize=30;horizontal=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="280" width="1560" height="140" as="geometry" />
    </mxCell>
    <!-- Swimlane 4: 零售人員 -->
    <mxCell id="lane4" value="四葉草書店&#xa;零售人員" style="swimlane;startSize=30;horizontal=0;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="420" width="1560" height="140" as="geometry" />
    </mxCell>
    <!-- Swimlane 5: 出版社 -->
    <mxCell id="lane5" value="出版社" style="swimlane;startSize=30;horizontal=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="560" width="1560" height="140" as="geometry" />
    </mxCell>

    <!-- ===== LANE 1: 使用者 ===== -->
    <!-- Start Event -->
    <mxCell id="e_start" value="開始&#xa;閱讀書籍" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="70" y="85" width="60" height="60" as="geometry" />
    </mxCell>
    <!-- Task: 撰寫書評 -->
    <mxCell id="u_write" value="撰寫書評" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="190" y="90" width="100" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 發布評論 -->
    <mxCell id="u_post" value="發布評論至&#xa;四葉草書評" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="360" y="90" width="110" height="50" as="geometry" />
    </mxCell>

    <!-- ===== LANE 2: 四葉草書評 ===== -->
    <!-- Task: 收錄書評 -->
    <mxCell id="b_collect" value="收錄書評&#xa;至資料庫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="530" y="205" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 爬取資料 -->
    <mxCell id="b_crawl" value="ListenAI&#xa;擷取書評資料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="700" y="205" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: NLP 情感分析 -->
    <mxCell id="b_nlp" value="NLP 情感分析&#xa;（正/中/負）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="870" y="205" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 詞頻統計 -->
    <mxCell id="b_stat" value="詞頻統計&#xa;與趨勢分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1040" y="205" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 產生報告 -->
    <mxCell id="b_report" value="產生分析報告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1210" y="205" width="110" height="50" as="geometry" />
    </mxCell>

    <!-- ===== LANE 3: 資料分析師 ===== -->
    <!-- Task: 檢視 Dashboard -->
    <mxCell id="a_view" value="檢視 ListenAI&#xa;Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="1210" y="320" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Gateway: 結果可信？ -->
    <mxCell id="gw_trust" value="結果&#xa;可信？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="1380" y="310" width="80" height="70" as="geometry" />
    </mxCell>
    <!-- Task: 人工重新標註 -->
    <mxCell id="a_relabel" value="人工審核&#xa;重新標註" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1380" y="265" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 提交備貨建議 -->
    <mxCell id="a_suggest" value="提交備貨建議" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="1500" y="320" width="110" height="50" as="geometry" />
    </mxCell>

    <!-- ===== LANE 4: 零售人員 ===== -->
    <!-- Task: 接收備貨建議 -->
    <mxCell id="r_receive" value="接收備貨建議" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1380" y="455" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Gateway: 庫存足夠？ -->
    <mxCell id="gw_stock" value="庫存&#xa;足夠？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1240" y="445" width="80" height="70" as="geometry" />
    </mxCell>
    <!-- Task: 直接上架 -->
    <mxCell id="r_shelf" value="上架熱門書籍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1100" y="455" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- End Event -->
    <mxCell id="e_end" value="銷售完成" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="955" y="460" width="60" height="60" as="geometry" />
    </mxCell>
    <!-- Task: 向出版社下訂單 -->
    <mxCell id="r_order" value="向出版社&#xa;下訂單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1100" y="575" width="110" height="50" as="geometry" />
    </mxCell>

    <!-- ===== LANE 5: 出版社 ===== -->
    <!-- Task: 接收訂單 -->
    <mxCell id="p_receive" value="接收訂單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="1240" y="620" width="110" height="50" as="geometry" />
    </mxCell>
    <!-- Task: 備貨出貨 -->
    <mxCell id="p_ship" value="備貨並出貨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="1100" y="620" width="110" height="50" as="geometry" />
    </mxCell>

    <!-- ===== FLOWS ===== -->
    <!-- Lane 1 flows -->
    <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="e_start" target="u_write" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="u_write" target="u_post" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Cross lane: 使用者 -> 四葉草書評 -->
    <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="u_post" target="b_collect" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Lane 2 flows -->
    <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_collect" target="b_crawl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_crawl" target="b_nlp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_nlp" target="b_stat" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_stat" target="b_report" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Cross lane: 四葉草書評 -> 資料分析師 -->
    <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_report" target="a_view" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Lane 3 flows -->
    <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="a_view" target="gw_trust" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f10" value="否" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gw_trust" target="a_relabel" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <!-- 例外：回送 NLP 重新分析 -->
    <mxCell id="f10b" value="重新分析" style="edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" source="a_relabel" target="b_nlp" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1350" y="290"/>
          <mxPoint x="925" y="290"/>
          <mxPoint x="925" y="255"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="f11" value="是" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gw_trust" target="a_suggest" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Cross lane: 資料分析師 -> 零售人員 -->
    <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="a_suggest" target="r_receive" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Lane 4 flows -->
    <mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_receive" target="gw_stock" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f14" value="是" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gw_stock" target="r_shelf" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_shelf" target="e_end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="f16" value="否" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gw_stock" target="r_order" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Cross lane: 零售人員 -> 出版社 -->
    <mxCell id="f17" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_order" target="p_receive" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Lane 5 flows -->
    <mxCell id="f18" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p_receive" target="p_ship" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- Cross lane: 出版社出貨 -> 零售人員上架 -->
    <mxCell id="f19" value="到貨" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p_ship" target="r_shelf" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

  </root>
</mxGraphModel>
